# ── Resend (Contact Form) ──────────────────────────────────────
# Sign up at https://resend.com, add and verify your domain,
# then create an API key.
RESEND_API_KEY=re_your_api_key_here
MAIL_SENDER=contact@darrylmunro.me
MAIL_RECIPIENT=daz@darrylmunro.me

# ── Cloudflare Turnstile (Contact Form spam protection) ────────
# Free, unlimited. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Choose widget mode "Managed". Add darrylmunro.me (plus .nz/.com) as hostnames.
# If these are unset the form still works, without the bot challenge.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key

# ── Contact form hardening ─────────────────────────────────────
# Secret used to sign the short-lived form token that catches instant,
# scripted submissions. Any long random string: `openssl rand -hex 32`
FORM_TOKEN_SECRET=

# Extra addresses to drop silently, comma-separated. Compared after
# normalisation, so Gmail dots and +tags do not need listing separately.
CONTACT_BLOCKLIST=

# ── Rate limiting (optional but recommended) ───────────────────
# Vercel's WAF rate limiting is Pro-only, so limits are enforced in the
# function. With these set, counters are shared across all serverless
# instances; without them it falls back to a weaker per-instance counter.
# Free tier at https://console.upstash.com — create a Redis database and
# copy its REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
