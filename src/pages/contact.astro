---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";

// Empty until the Cloudflare keys are configured; the form still works, it
// just has one fewer layer of protection.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Layout title={`Contact | ${SITE.title}`} description="Get in touch with Darryl Munro. Architecture, AI, neurodiversity, and technology leadership.">
  <Header />
  <main id="main-content" class="relative z-1">
    <div class="mx-auto max-w-[740px] px-6">

      <section class="pt-22 pb-10 relative">
        <div class="absolute left-0 top-20 bottom-4 w-[3px] rounded-sm opacity-60" style="background: linear-gradient(180deg, var(--accent) 0%, var(--gold) 100%);"></div>

        <div class="font-[var(--font-mono)] text-xs font-medium text-accent tracking-[0.12em] uppercase mb-5 flex items-center gap-2.5">
          Let's talk
          <span class="block w-8 h-px bg-accent-dim"></span>
        </div>
        <h1 class="font-[var(--font-head)] text-[clamp(32px,5vw,44px)] font-bold leading-[1.1] tracking-[-0.02em] text-foreground mb-4">
          Contact
        </h1>
        <p class="text-[17px] leading-[1.75] text-text-secondary max-w-[580px]">
          Whether you're working on something interesting, need architecture guidance, or want to talk about neurodiversity in the workplace — I'd like to hear from you.
        </p>
      </section>

      <div class="border-t border-border"></div>

      <section class="py-12" style="border: none;">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_280px] gap-10">

          <!-- Contact Form -->
          <form
            id="contact-form"
            class="space-y-6"
            action="#"
            method="POST"
            data-form-endpoint=""
            data-turnstile-sitekey={turnstileSiteKey}
          >
            <!-- Name -->
            <div>
              <label for="name" class="block font-[var(--font-mono)] text-xs text-muted tracking-[0.08em] uppercase mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-background-raised border border-border rounded px-4 py-3 text-foreground text-[15px] font-[var(--font-body)] placeholder:text-muted focus:outline-none focus:border-accent transition-colors"
                placeholder="Your name"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block font-[var(--font-mono)] text-xs text-muted tracking-[0.08em] uppercase mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-background-raised border border-border rounded px-4 py-3 text-foreground text-[15px] font-[var(--font-body)] placeholder:text-muted focus:outline-none focus:border-accent transition-colors"
                placeholder="your@email.com"
              />
            </div>

            <!-- Subject -->
            <div>
              <label for="subject" class="block font-[var(--font-mono)] text-xs text-muted tracking-[0.08em] uppercase mb-2">Subject</label>
              <select
                id="subject"
                name="subject"
                class="w-full bg-background-raised border border-border rounded px-4 py-3 text-foreground text-[15px] font-[var(--font-body)] focus:outline-none focus:border-accent transition-colors"
              >
                <option value="general">General enquiry</option>
                <option value="fractional-cto">Fractional CTO / CIO</option>
                <option value="ea-consulting">Enterprise Architecture Consulting</option>
                <option value="nd-coaching">Neurodiversity Coaching</option>
                <option value="workplace-nd">Workplace Neurodiversity Programme</option>
                <option value="speaking">Speaking / Events</option>
                <option value="other">Something else</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block font-[var(--font-mono)] text-xs text-muted tracking-[0.08em] uppercase mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full bg-background-raised border border-border rounded px-4 py-3 text-foreground text-[15px] font-[var(--font-body)] placeholder:text-muted focus:outline-none focus:border-accent transition-colors resize-y"
                placeholder="Tell me what you're working on..."
              ></textarea>
            </div>

            <!-- Honeypot — hidden from humans, filled by bots -->
            <div style="position: absolute; left: -9999px; opacity: 0; height: 0;" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Cloudflare Turnstile — rendered explicitly by the script below -->
            {turnstileSiteKey && <div id="turnstile-widget" class="min-h-[65px]"></div>}

            <button
              type="submit"
              class="inline-flex items-center gap-[7px] bg-accent text-[#0e1a0e] font-[var(--font-body)] font-semibold text-sm px-6 py-3 rounded transition-all hover:brightness-110 hover:-translate-y-px cursor-pointer"
            >
              Send message
            </button>

            <!-- Success message (hidden by default) -->
            <div id="form-success" class="hidden bg-background-raised border border-accent rounded p-4">
              <p class="text-accent font-semibold text-sm">Message sent. I'll get back to you shortly.</p>
            </div>

            <!-- Error message (hidden by default) -->
            <div id="form-error" class="hidden bg-background-raised border border-gold rounded p-4">
              <p id="form-error-text" class="text-gold font-semibold text-sm">Something went wrong. Please try emailing me directly.</p>
            </div>
          </form>

          <!-- Sidebar info -->
          <div class="space-y-6">
            <div class="bg-background-raised border border-border rounded-md p-6">
              <h3 class="font-[var(--font-head)] text-sm font-semibold text-foreground mb-3">Direct contact</h3>
              <div class="space-y-2 text-sm text-text-secondary">
                <p>
                  <a href="mailto:darryl@darrylmunro.nz" class="text-accent hover:underline">darryl@darrylmunro.nz</a>
                </p>
                <p>Otepoti / Dunedin, New Zealand</p>
              </div>
            </div>

            <div class="bg-background-raised border border-border rounded-md p-6">
              <h3 class="font-[var(--font-head)] text-sm font-semibold text-foreground mb-3">Find me online</h3>
              <div class="space-y-2 text-sm">
                <a href="https://github.com/munrodnz" class="block text-text-secondary hover:text-accent transition-colors">GitHub</a>
                <a href="https://linkedin.com/in/darryl-munro" class="block text-text-secondary hover:text-accent transition-colors">LinkedIn</a>
                <a href="https://x.com/munrod10" class="block text-text-secondary hover:text-accent transition-colors">X / Twitter</a>
              </div>
            </div>

            <div class="bg-background-raised border border-border border-l-3 border-l-gold rounded-r-md p-6">
              <p class="text-text-secondary text-sm leading-relaxed">
                <strong class="text-foreground">Response time:</strong> I typically reply within 1-2 business days. For urgent matters, email directly.
              </p>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>
)}

<script>
  const TOKEN_ENDPOINT = "/api/form-token";
  const CONTACT_ENDPOINT = "/api/contact";
  // Must clear the server's MIN_AGE_MS before a retry token is accepted.
  const TOKEN_SETTLE_MS = 3200;

  function setupContactForm() {
    const form = document.querySelector("#contact-form") as HTMLFormElement;
    const successEl = document.querySelector("#form-success");
    const errorEl = document.querySelector("#form-error");
    const errorTextEl = document.querySelector("#form-error-text");
    const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement;

    if (!form || !submitBtn) return;

    // ── Signed timing token ───────────────────────────────────
    let formToken: string | null = null;

    async function fetchFormToken() {
      try {
        const res = await fetch(TOKEN_ENDPOINT, { cache: "no-store" });
        if (!res.ok) return;
        formToken = (await res.json())?.token ?? null;
      } catch {
        // Recovered at submit time.
      }
    }

    fetchFormToken();

    // ── Turnstile ─────────────────────────────────────────────
    const siteKey = form.dataset.turnstileSitekey;
    const widgetHost = document.querySelector("#turnstile-widget");
    let widgetId: string | null = null;

    function renderTurnstile() {
      const turnstile = (window as any).turnstile;
      if (!turnstile || !widgetHost) return;
      widgetHost.innerHTML = "";
      widgetId = turnstile.render(widgetHost, {
        sitekey: siteKey,
        action: "contact",
        theme: "auto",
      });
    }

    if (siteKey && widgetHost) {
      if ((window as any).turnstile) {
        renderTurnstile();
      } else {
        // The script is async, so wait for it rather than racing it.
        const poll = setInterval(() => {
          if ((window as any).turnstile) {
            clearInterval(poll);
            renderTurnstile();
          }
        }, 200);
        setTimeout(() => clearInterval(poll), 15000);
      }
    }

    function showError(message?: string) {
      if (errorTextEl && message) errorTextEl.textContent = message;
      errorEl?.classList.remove("hidden");
    }

    function post(payload: Record<string, unknown>) {
      return fetch(CONTACT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));

      const turnstile = (window as any).turnstile;
      const turnstileToken =
        siteKey && turnstile && widgetId !== null
          ? turnstile.getResponse(widgetId)
          : undefined;

      successEl?.classList.add("hidden");
      errorEl?.classList.add("hidden");

      if (siteKey && !turnstileToken) {
        showError("Please complete the verification check, then send again.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";

      try {
        if (!formToken) await fetchFormToken();

        let response = await post({ ...data, formToken, turnstileToken });

        // A stale or missing token is recoverable — fetch a fresh one, let it
        // age past the server's minimum, and retry once.
        if (response.status === 400) {
          const body = await response.clone().json().catch(() => ({}) as any);
          if (body?.error === "expired_token" || body?.error === "missing_token") {
            await fetchFormToken();
            await new Promise((resolve) => setTimeout(resolve, TOKEN_SETTLE_MS));
            response = await post({ ...data, formToken, turnstileToken });
          }
        }

        if (response.ok) {
          successEl?.classList.remove("hidden");
          form.reset();
        } else {
          const body = await response.json().catch(() => ({}) as any);
          showError(
            body?.error && response.status !== 500
              ? body.error
              : "Something went wrong. Please try emailing me directly.",
          );
        }
      } catch {
        showError("Something went wrong. Please try emailing me directly.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send message";
        // Turnstile tokens are single-use.
        (window as any).turnstile?.reset?.(widgetId);
      }
    });
  }

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
